{
  "name": "@neomaventures/managed-datasource",
  "version": "0.1.0",
  "description": "In-memory SQLite DataSource for NestJS tests — cached per entity set and destroyed between specs.",
  "author": "Daniel Bruce",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neomaventures/managed-datasource.git"
  },
  "bugs": {
    "url": "https://github.com/neomaventures/managed-datasource/issues"
  },
  "homepage": "https://github.com/neomaventures/managed-datasource#readme",
  "keywords": [
    "nestjs",
    "typeorm",
    "datasource",
    "data-source",
    "testing",
    "sqlite",
    "jest",
    "fixture",
    "typescript"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "!**/*.json",
    "!**/*.tsbuildinfo"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsc -p ./tsconfig.lib.json",
    "test": "jest --runInBand",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "@nestjs/common": "11.x",
    "@nestjs/core": "11.x",
    "@nestjs/typeorm": "^11.x",
    "better-sqlite3": "^12",
    "typeorm": "^1.1.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    },
    "@nestjs/core": {
      "optional": true
    },
    "@nestjs/typeorm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/common": "^11.1.18",
    "@nestjs/core": "^11.1.18",
    "@nestjs/testing": "^11.1.18",
    "@nestjs/typeorm": "^11.0.0",
    "@swc/core": "^1.12.1",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.5.2",
    "better-sqlite3": "^13.0.3",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-jest": "^29.15.3",
    "eslint-plugin-jest-extended": "^3.0.1",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-yml": "^3.3.2",
    "globals": "^17.4.0",
    "jest": "^30.3.0",
    "jest-extended": "^7.0.0",
    "prettier": "^3.4.2",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.1.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.5.0",
  "engines": {
    "node": ">=22"
  }
